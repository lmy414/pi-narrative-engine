    "import": "node dist/tools/import-novel.js",
    "init": "node scripts/init-novel.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "epub2": "^3.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.77.0",
    "@earendil-works/pi-coding-agent": "^0.77.0",
    "@types/node": "^20.14.0",
    "typebox": "^1.1.24",
    "typescript": "^5.4.0"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  }
}
