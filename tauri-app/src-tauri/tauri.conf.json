{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "narrative-engine",
  "version": "0.1.0-alpha.1",
  "identifier": "com.narrative-engine.app",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../scripts/package-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Narrative Engine",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:7421 http://localhost:7421; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/runtime/**/*": "runtime/",
      "resources/server/**/*": "server/"
    }
  }
}
