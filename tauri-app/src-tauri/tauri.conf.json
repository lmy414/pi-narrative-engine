{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "narrative-engine",
  "version": "0.1.0",
  "identifier": "com.narrative-engine.app",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Narrative Engine",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/**/*"
    ]
  }
}
